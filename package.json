{
  "name": "ugtbrowser",
  "version": "2.3.0",
  "description": "Inline translation of highlighted text using state-of-the-art AI models.",
  "scripts": {
    "test": "node --experimental-default-type=module --test",
    "test:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/live-providers/run.mjs",
    "test:pages": "node tools/page-corpus/run.mjs",
    "package": "node package-extension.js",
    "webstore": "node tools/webstore/publish.mjs",
    "webstore:token": "node tools/webstore/get-refresh-token.mjs"
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "translation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
